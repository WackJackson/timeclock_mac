.home-container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 背景渐变 - 根据模式切换 */
.working-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f64f59 100%);
  color: white;
}

/* 燃尽模式背景 */
.working-bg.burnout-mode {
  background: linear-gradient(135deg, #1a1a1a 0%, #dc2626 50%, #7f1d1d 100%);
  color: white;
}

/* 摸鱼模式背景 */
.working-bg.slack-mode {
  background: linear-gradient(135deg, #10b981 0%, #3b82f6 50%, #8b5cf6 100%);
  color: white;
}

.resting-bg {
  background: linear-gradient(180deg, #a8edea 0%, #fed6e3 100%);
  color: #242424;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  position: relative;
}

.status-dot.working {
  background: #4ade80;
}

.status-dot.resting {
  background: #10b981;
}

.pulse-ring {
  position: absolute;
  inset: 0;
  width: 20rpx;
  height: 20rpx;
  background: #4ade80;
  border-radius: 50%;
  animation: pulse 2s ease-out infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.status-text {
  font-size: 28rpx;
  font-weight: 500;
}

.status-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 云朵装饰 */
.clouds {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  pointer-events: none;
}

.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 200rpx;
  animation: float 6s ease-in-out infinite;
}

.cloud-1 {
  width: 120rpx;
  height: 60rpx;
  top: 80rpx;
  left: 40rpx;
}

.cloud-2 {
  width: 100rpx;
  height: 50rpx;
  top: 160rpx;
  right: 60rpx;
  animation-delay: -3s;
}

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); }
  50% { transform: translateY(-20rpx) translateX(20rpx); }
}

/* 气泡装饰 - 摸鱼模式 */
.bubbles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.bubble {
  position: absolute;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: bubble-rise 4s ease-in infinite;
}

.bubble-1 {
  width: 60rpx;
  height: 60rpx;
  left: 20%;
  bottom: -60rpx;
  animation-delay: 0s;
}

.bubble-2 {
  width: 40rpx;
  height: 40rpx;
  left: 50%;
  bottom: -40rpx;
  animation-delay: 1s;
}

.bubble-3 {
  width: 80rpx;
  height: 80rpx;
  left: 70%;
  bottom: -80rpx;
  animation-delay: 2s;
}

.bubble-4 {
  width: 50rpx;
  height: 50rpx;
  left: 35%;
  bottom: -50rpx;
  animation-delay: 3s;
}

@keyframes bubble-rise {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0.6;
  }
  50% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(-1000rpx) scale(1.2);
    opacity: 0;
  }
}

/* 火焰装饰 - 燃尽模式 */
.flames {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.flame {
  position: absolute;
  width: 40rpx;
  height: 80rpx;
  background: linear-gradient(to top, #dc2626, #f97316, transparent);
  border-radius: 50% 50% 0 0;
  animation: flame-flicker 1s ease-in-out infinite;
  opacity: 0.7;
}

.flame-1 {
  left: 10%;
  bottom: 200rpx;
  animation-delay: 0s;
}

.flame-2 {
  right: 15%;
  bottom: 300rpx;
  animation-delay: 0.3s;
}

.flame-3 {
  left: 50%;
  bottom: 150rpx;
  animation-delay: 0.6s;
}

@keyframes flame-flicker {
  0%, 100% {
    transform: scaleY(1) translateY(0);
    opacity: 0.7;
  }
  50% {
    transform: scaleY(1.3) translateY(-20rpx);
    opacity: 0.9;
  }
}

/* 金额展示区 */
.money-display {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.float-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: float 4s ease-in-out infinite;
}

.display-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 16rpx;
}

.money-amount {
  display: inline-block;
}

.money-pulse {
  animation: money-pulse 1s ease-in-out infinite;
}

@keyframes money-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.amount-main {
  font-size: 120rpx;
  font-weight: bold;
  line-height: 1;
}

.working-bg .amount-main {
  text-shadow: 0 0 40rpx rgba(255, 255, 255, 0.5);
}

.amount-decimal {
  font-size: 64rpx;
  font-weight: bold;
}

.display-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}

/* 时间统计 */
.time-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* 维度切换 */
.dimension-tabs {
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 8rpx;
  overflow: hidden;
}

/* 覆盖TDesign tabs组件的默认样式 */
.dimension-tabs .t-tabs {
  background: transparent !important;
}

.dimension-tabs .t-tabs__nav {
  background: transparent !important;
}

.dimension-tabs .t-tabs__item {
  background: transparent !important;
  color: rgba(255, 255, 255, 0.7) !important;
}

.dimension-tabs .t-tabs__item--active {
  background: rgba(255, 255, 255, 0.25) !important;
  color: white !important;
  border-radius: 16rpx !important;
}

.dimension-tabs .t-tabs__track {
  display: none !important;
}

.resting-bg .dimension-tabs {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
}

.resting-bg .dimension-tabs .t-tabs__item {
  color: rgba(0, 0, 0, 0.6) !important;
}

.resting-bg .dimension-tabs .t-tabs__item--active {
  background: rgba(0, 82, 217, 0.1) !important;
  color: #0052d9 !important;
}

/* 燃尽模式下的维度切换 */
.burnout-mode .dimension-tabs {
  background: rgba(220, 38, 38, 0.2);
  backdrop-filter: blur(20rpx);
}

.burnout-mode .dimension-tabs .t-tabs__item--active {
  background: rgba(220, 38, 38, 0.4) !important;
  color: white !important;
}

/* 摸鱼模式下的维度切换 */
.slack-mode .dimension-tabs {
  background: rgba(16, 185, 129, 0.2);
  backdrop-filter: blur(20rpx);
}

.slack-mode .dimension-tabs .t-tabs__item--active {
  background: rgba(16, 185, 129, 0.4) !important;
  color: white !important;
}

/* 进度卡片 */
.progress-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.resting-bg .progress-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
}

/* 燃尽模式下的进度卡片 */
.burnout-mode .progress-card {
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(220, 38, 38, 0.3);
}

/* 摸鱼模式下的进度卡片 */
.slack-mode .progress-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(16, 185, 129, 0.3);
}

.card-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.progress-percent {
  font-size: 24rpx;
  font-weight: bold;
}

.progress-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
}

.resting-bg .progress-bar-bg {
  background: #e5e7eb;
}

.progress-bar-fill {
  height: 100%;
  background: white;
  border-radius: 16rpx;
  transition: width 0.3s ease;
}

.resting-bg .progress-bar-fill {
  background: linear-gradient(90deg, #10b981 0%, #3b82f6 100%);
}

/* 燃尽模式进度条 */
.burnout-mode .progress-bar-fill {
  background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
  box-shadow: 0 0 20rpx rgba(220, 38, 38, 0.6);
}

/* 摸鱼模式进度条 */
.slack-mode .progress-bar-fill {
  background: linear-gradient(90deg, #10b981 0%, #06b6d4 100%);
  box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.4);
}

/* 模式选择 */
.mode-section {
  margin-bottom: 32rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}

.mode-buttons {
  display: flex;
  gap: 24rpx;
}

.mode-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 4rpx solid transparent;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.mode-btn.active {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.4);
  opacity: 1;
  transform: scale(1.05);
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.3);
}

/* 燃尽模式激活样式 */
.burnout-mode .mode-btn.active {
  background: rgba(220, 38, 38, 0.3);
  border-color: rgba(220, 38, 38, 0.6);
  box-shadow: 0 20rpx 50rpx -10rpx rgba(220, 38, 38, 0.5);
}

/* 摸鱼模式激活样式 */
.slack-mode .mode-btn.active {
  background: rgba(16, 185, 129, 0.3);
  border-color: rgba(16, 185, 129, 0.6);
  box-shadow: 0 20rpx 50rpx -10rpx rgba(16, 185, 129, 0.5);
}

.mode-icon {
  font-size: 40rpx;
}

.mode-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 倒计时 */
.countdown-section {
  margin-bottom: 32rpx;
}

.countdown-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.countdown-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
}

.countdown-icon {
  font-size: 36rpx;
}

.countdown-label {
  font-size: 20rpx;
  opacity: 0.7;
}

.countdown-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

/* 下一时段卡片 */
.next-segment-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.segment-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.segment-hint {
  display: block;
  font-size: 20rpx;
  color: #666;
}

.segment-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin: 4rpx 0;
}

.segment-time {
  display: block;
  font-size: 20rpx;
  color: #999;
}

.segment-countdown {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #242424;
}

.segment-countdown-label {
  display: block;
  font-size: 20rpx;
  color: #999;
}
