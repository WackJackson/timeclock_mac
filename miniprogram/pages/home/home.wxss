.home-container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 背景渐变 */
.working-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f64f59 100%);
  color: white;
}

.resting-bg {
  background: linear-gradient(180deg, #a8edea 0%, #fed6e3 100%);
  color: #242424;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  position: relative;
}

.status-dot.working {
  background: #4ade80;
}

.status-dot.resting {
  background: #10b981;
}

.pulse-ring {
  position: absolute;
  inset: 0;
  width: 20rpx;
  height: 20rpx;
  background: #4ade80;
  border-radius: 50%;
  animation: pulse 2s ease-out infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.status-text {
  font-size: 28rpx;
  font-weight: 500;
}

.status-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 云朵装饰 */
.clouds {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  pointer-events: none;
}

.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 200rpx;
  animation: float 6s ease-in-out infinite;
}

.cloud-1 {
  width: 120rpx;
  height: 60rpx;
  top: 80rpx;
  left: 40rpx;
}

.cloud-2 {
  width: 100rpx;
  height: 50rpx;
  top: 160rpx;
  right: 60rpx;
  animation-delay: -3s;
}

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); }
  50% { transform: translateY(-20rpx) translateX(20rpx); }
}

/* 金额展示区 */
.money-display {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.float-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: float 4s ease-in-out infinite;
}

.display-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 16rpx;
}

.money-amount {
  display: inline-block;
}

.money-pulse {
  animation: money-pulse 1s ease-in-out infinite;
}

@keyframes money-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.amount-main {
  font-size: 120rpx;
  font-weight: bold;
  line-height: 1;
}

.working-bg .amount-main {
  text-shadow: 0 0 40rpx rgba(255, 255, 255, 0.5);
}

.amount-decimal {
  font-size: 64rpx;
  font-weight: bold;
}

.display-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}

/* 时间统计 */
.time-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* 维度切换 */
.dimension-tabs {
  margin-bottom: 32rpx;
}

/* 进度卡片 */
.progress-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.resting-bg .progress-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
}

.card-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.progress-percent {
  font-size: 24rpx;
  font-weight: bold;
}

.progress-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
}

.resting-bg .progress-bar-bg {
  background: #e5e7eb;
}

.progress-bar-fill {
  height: 100%;
  background: white;
  border-radius: 16rpx;
  transition: width 0.3s ease;
}

.resting-bg .progress-bar-fill {
  background: linear-gradient(90deg, #10b981 0%, #3b82f6 100%);
}

/* 模式选择 */
.mode-section {
  margin-bottom: 32rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}

.mode-buttons {
  display: flex;
  gap: 24rpx;
}

.mode-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 4rpx solid transparent;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.mode-btn.active {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.4);
  opacity: 1;
  transform: scale(1.05);
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.3);
}

.mode-icon {
  font-size: 40rpx;
}

.mode-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 倒计时 */
.countdown-section {
  margin-bottom: 32rpx;
}

.countdown-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.countdown-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
}

.countdown-icon {
  font-size: 36rpx;
}

.countdown-label {
  font-size: 20rpx;
  opacity: 0.7;
}

.countdown-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

/* 下一时段卡片 */
.next-segment-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.segment-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.segment-hint {
  display: block;
  font-size: 20rpx;
  color: #666;
}

.segment-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin: 4rpx 0;
}

.segment-time {
  display: block;
  font-size: 20rpx;
  color: #999;
}

.segment-countdown {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #242424;
}

.segment-countdown-label {
  display: block;
  font-size: 20rpx;
  color: #999;
}
