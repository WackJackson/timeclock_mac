.setup-container {
  min-height: 100vh;
  background: white;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 头部 */
.header {
  padding: 96rpx 32rpx 48rpx;
  box-sizing: border-box;
  width: 100%;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #242424;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
}

/* 进度指示器 */
.progress-indicator {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
  width: 100%;
}

.progress-bars {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.progress-bar.active {
  background: #0052d9;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
}

/* 表单内容 */
.form-content {
  flex: 1;
  padding: 32rpx 32rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  width: 100%;
}

.form-section {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-card {
  background: white;
  border-radius: 32rpx;
  border: 2rpx solid #f0f0f0;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  width: 100%;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.label-icon {
  width: 48rpx;
  height: 48rpx;
  background: #ecf2fe;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #242424;
}

/* 月薪输入 */
.salary-input-wrapper {
  position: relative;
  margin-bottom: 16rpx;
}

.currency-symbol {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #666;
}

.salary-input {
  width: 100%;
  height: 112rpx;
  padding-left: 80rpx;
  padding-right: 32rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #242424;
  background: #f5f5f5;
  border-radius: 24rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
}

.salary-input:focus {
  border-color: #0052d9;
  background: white;
}

.form-hint {
  font-size: 20rpx;
  color: #999;
}

/* 工作日选择 */
.weekdays-selector {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 16rpx;
}

.weekday-item {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 4rpx solid #e5e7eb;
  background: white;
  transition: all 0.3s ease;
}

.weekday-item.selected {
  background: #0052d9;
  border-color: #0052d9;
}

.weekday-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  transition: color 0.3s ease;
}

.weekday-item.selected .weekday-text {
  color: white;
}

/* 时段列表 */
.segments-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.segment-item {
  padding: 24rpx;
  border-radius: 24rpx;
}

.work-segment {
  background: linear-gradient(135deg, #f0f7ff 0%, #e8f4fd 100%);
}

.rest-segment {
  background: linear-gradient(135deg, #f0fff4 0%, #e8fdf0 100%);
  border: 2rpx dashed #00a870;
}

.segment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.segment-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  transition: color 0.3s ease;
}

.segment-delete:active {
  color: #e34d59;
}

.delete-icon {
  font-size: 48rpx;
  line-height: 1;
}

.auto-label {
  font-size: 20rpx;
  color: #999;
}

.segment-name-input {
  width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  color: #242424;
  background: transparent;
  margin-bottom: 16rpx;
  border: none;
}

.segment-time {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-picker {
  flex: 1;
  padding: 16rpx 24rpx;
  background: white;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.time-separator {
  font-size: 24rpx;
  color: #999;
}

.rest-desc {
  font-size: 24rpx;
  color: #666;
}

/* 添加按钮 */
.add-segment-btn {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 4rpx dashed #e5e7eb;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #999;
  transition: all 0.3s ease;
}

.add-segment-btn:active {
  border-color: #0052d9;
  color: #0052d9;
}

.add-icon {
  font-size: 40rpx;
  line-height: 1;
}

.add-text {
  font-size: 28rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, white 80%, transparent);
  box-sizing: border-box;
}

/* 日期选择器 */
.date-picker-wrapper {
  margin-bottom: 16rpx;
}

.date-picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.date-picker-display:active {
  border-color: #0052d9;
  background: white;
}

.date-label {
  font-size: 28rpx;
  color: #666;
}

.date-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #242424;
}

.date-value .placeholder {
  color: #999;
  font-weight: normal;
}

.date-value .arrow {
  font-size: 40rpx;
  color: #999;
}
