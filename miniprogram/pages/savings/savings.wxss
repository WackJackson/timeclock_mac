.savings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 头部 */
.header {
  background: white;
  padding: 32rpx 48rpx 48rpx;
  padding-top: env(safe-area-inset-top);
}

/* 自定义导航栏 */
.custom-nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 80rpx;
  margin-bottom: 40rpx;
}

.header-content {
  /* 原有内容 */
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #242424;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 总进度卡片 */
.total-progress-card {
  margin-top: 32rpx;
  padding: 32rpx;
  background: linear-gradient(165deg, #4a6fa5 0%, #7fa4c3 40%, #a8c5da 100%);
  border-radius: 32rpx;
  color: white;
  box-shadow: 0 16rpx 40rpx rgba(79, 164, 195, 0.3);
}

.total-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
}

.total-amount {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin: 8rpx 0 24rpx;
}

.total-progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.total-progress-fill {
  height: 100%;
  background: white;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.total-percent {
  font-size: 20rpx;
}

/* 愿望列表 */
.wish-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.wish-card {
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.wish-card.active {
  border-color: #0052d9;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 82, 217, 0.2);
  transform: translateY(-4rpx);
}

.wish-content {
  display: flex;
  gap: 32rpx;
}

/* 愿望图标 */
.wish-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
}

.icon-emoji {
  font-size: 64rpx;
}

.check-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 48rpx;
  height: 48rpx;
  background: #00a870;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
}

.check-icon {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 愿望信息 */
.wish-info {
  flex: 1;
  min-width: 0;
}

.wish-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.wish-date {
  font-size: 20rpx;
  color: #999;
}

.wish-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin-bottom: 8rpx;
}

.wish-amounts {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.current-amount {
  font-weight: bold;
}

.amount-separator {
  margin: 0 8rpx;
  color: #999;
}

.target-amount {
  color: #666;
}

/* 进度条 */
.wish-progress {
  margin-top: 24rpx;
}

.wish-progress-bg {
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.wish-progress-fill {
  height: 100%;
  border-radius: 20rpx;
  transition: width 0.5s ease;
}

.wish-progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.progress-percent {
  font-weight: 500;
}

.progress-remain {
  color: #666;
}

/* 新建按钮 */
.fab-button {
  position: fixed;
  bottom: 160rpx;
  right: 48rpx;
  width: 112rpx;
  height: 112rpx;
  background: #0052d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 82, 217, 0.4);
  transition: all 0.3s ease;
}

.fab-button:active {
  transform: scale(0.95);
}

.fab-icon {
  color: white;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

/* 自定义弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 48rpx;
}

.modal-container {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 40rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #242424;
}

.modal-content {
  padding: 32rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.form-field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #242424;
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff !important;
  border: 3rpx solid #0052d9 !important;
  border-radius: 16rpx;
  font-size: 32rpx !important;
  color: #000000 !important;
  box-sizing: border-box;
  line-height: 88rpx;
}

.field-input::placeholder {
  color: #999999 !important;
  font-size: 28rpx !important;
}

.field-input:focus {
  background: #ffffff !important;
  border-color: #0052d9 !important;
}

.amount-wrapper {
  position: relative;
}

.amount-prefix {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  font-weight: 600;
  color: #242424;
  z-index: 1;
}

.amount-input {
  padding-left: 64rpx;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.emoji-option {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 3rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 48rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.emoji-option.selected {
  background: #ecf2fe;
  border-color: #0052d9;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.2);
}

.emoji-input-wrapper {
  padding: 0;
  overflow: hidden;
}

.emoji-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 48rpx;
  border: none;
  background: transparent;
  color: #000000;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.3s ease;
}

.cancel-btn {
  color: #666;
  background: #fff;
}

.cancel-btn:active {
  background: #f5f5f5;
}

.confirm-btn {
  color: #fff;
  background: #0052d9;
}

.confirm-btn:active {
  background: #0041b0;
}
