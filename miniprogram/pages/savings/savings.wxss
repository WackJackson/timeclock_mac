.savings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 头部 */
.header {
  background: white;
  padding: 32rpx 48rpx 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #242424;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 总进度卡片 */
.total-progress-card {
  margin-top: 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  border-radius: 32rpx;
  color: white;
  box-shadow: 0 16rpx 40rpx rgba(59, 130, 246, 0.3);
}

.total-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
}

.total-amount {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin: 8rpx 0 24rpx;
}

.total-progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.total-progress-fill {
  height: 100%;
  background: white;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.total-percent {
  font-size: 20rpx;
}

/* 愿望列表 */
.wish-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.wish-card {
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.wish-card.active {
  border-color: #0052d9;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 82, 217, 0.2);
  transform: translateY(-4rpx);
}

.wish-content {
  display: flex;
  gap: 32rpx;
}

/* 愿望图标 */
.wish-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
}

.icon-emoji {
  font-size: 64rpx;
}

.check-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 48rpx;
  height: 48rpx;
  background: #00a870;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
}

.check-icon {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 愿望信息 */
.wish-info {
  flex: 1;
  min-width: 0;
}

.wish-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.wish-date {
  font-size: 20rpx;
  color: #999;
}

.wish-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin-bottom: 8rpx;
}

.wish-amounts {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.current-amount {
  font-weight: bold;
}

.amount-separator {
  margin: 0 8rpx;
  color: #999;
}

.target-amount {
  color: #666;
}

/* 进度条 */
.wish-progress {
  margin-top: 24rpx;
}

.wish-progress-bg {
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.wish-progress-fill {
  height: 100%;
  border-radius: 20rpx;
  transition: width 0.5s ease;
}

.wish-progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.progress-percent {
  font-weight: 500;
}

.progress-remain {
  color: #666;
}

/* 新建按钮 */
.fab-button {
  position: fixed;
  bottom: 160rpx;
  right: 48rpx;
  width: 112rpx;
  height: 112rpx;
  background: #0052d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 82, 217, 0.4);
  transition: all 0.3s ease;
}

.fab-button:active {
  transform: scale(0.95);
}

.fab-icon {
  color: white;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

/* 创建对话框样式 */
.create-dialog-content {
  padding: 24rpx 0;
}

.dialog-field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #242424;
  box-sizing: border-box;
}

.amount-input-wrapper {
  position: relative;
}

.amount-symbol {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #666;
}

.amount-input {
  padding-left: 56rpx;
}

.emoji-selector {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
}

.emoji-item {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.emoji-item.selected {
  background: #ecf2fe;
  border-color: #0052d9;
}

.emoji-text {
  font-size: 40rpx;
}
