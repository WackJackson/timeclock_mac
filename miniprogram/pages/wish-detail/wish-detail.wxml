<view class="detail-container">
  <!-- 头部背景 -->
  <view class="header-bg">
    <!-- 导航按钮 -->
    <view class="nav-buttons">
      <view class="nav-btn" bindtap="goBack">
        <text class="nav-icon">←</text>
      </view>
      <view class="nav-btn" bindtap="showMore">
        <text class="nav-icon">⋮</text>
      </view>
    </view>

    <!-- 愿望信息 -->
    <view class="wish-header">
      <view class="wish-icon-large" style="background: {{wishData.color}};">
        <text class="icon-emoji-large">{{wishData.emoji}}</text>
      </view>
      <text class="wish-title">{{wishData.name}}</text>
      <text class="wish-desc">{{wishData.description}}</text>
    </view>
  </view>

  <!-- 进度卡片 -->
  <view class="progress-card">
    <view class="progress-header">
      <text class="progress-label">当前进度</text>
      <view class="progress-amounts">
        <text class="amount-current">¥{{wishData.currentAmount}}</text>
        <text class="amount-separator"> / </text>
        <text class="amount-target">¥{{wishData.targetAmount}}</text>
      </view>
    </view>

    <!-- 总进度百分比 -->
    <view class="total-progress-percent">
      <text class="progress-number">{{wishData.progress}}%</text>
    </view>

    <!-- 三色进度条 -->
    <view class="multi-progress-bar">
      <view class="progress-segment progress-normal" style="width: {{modeProgress.normal}}%;"></view>
      <view class="progress-segment progress-burnout" style="width: {{modeProgress.burnout}}%;"></view>
      <view class="progress-segment progress-slack" style="width: {{modeProgress.slack}}%;"></view>
    </view>

    <!-- 进度说明 -->
    <view class="progress-legend">
      <view class="legend-item" wx:if="{{modeProgress.normal > 0}}">
        <view class="legend-dot legend-normal"></view>
        <text class="legend-text">普通 {{modeProgress.normal}}%</text>
      </view>
      <view class="legend-item" wx:if="{{modeProgress.burnout > 0}}">
        <view class="legend-dot legend-burnout"></view>
        <text class="legend-text">燃尽 {{modeProgress.burnout}}%</text>
      </view>
      <view class="legend-item" wx:if="{{modeProgress.slack > 0}}">
        <view class="legend-dot legend-slack"></view>
        <text class="legend-text">摸鱼 {{modeProgress.slack}}%</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">已攒天数</text>
        <text class="stat-value">{{stats.savedDays}} 天</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">预计完成</text>
        <text class="stat-value">{{stats.estimatedDays}} 天后</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">所需时间</text>
        <text class="stat-value">{{stats.totalMinutes}} 分钟</text>
      </view>
    </view>
  </view>

  <!-- 资金来源 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">资金来源</text>
    </view>

    <view class="records-list" wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-icon" style="background: {{item.iconBg}};">
          <text class="record-emoji">{{item.icon}}</text>
        </view>
        <view class="record-info">
          <view class="record-title-row">
            <text class="record-name">{{item.modeName}}</text>
            <t-tag
              theme="{{item.modeTheme}}"
              size="small"
              variant="light"
            >
              {{item.minutes}}分钟
            </t-tag>
          </view>
        </view>
        <text class="record-amount" style="color: {{item.amountColor}};">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="empty-records" wx:if="{{records.length === 0}}">
      <text class="empty-text">暂无资金来源</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions">
    <t-button
      theme="primary"
      size="large"
      block
      bindtap="setActive"
      wx:if="{{wishData.status !== 'active'}}"
    >
      设为进行中
    </t-button>
    <t-button
      theme="default"
      size="large"
      block
      bindtap="pauseWish"
      wx:if="{{wishData.status === 'active'}}"
    >
      暂停攒钱
    </t-button>
  </view>
</view>
