<view class="profile-container">
  <!-- 未登录时显示的引导界面 -->
  <view class="login-guide" wx:if="{{showLoginGuide}}">
    <view class="guide-card">
      <view class="guide-icon">🔐</view>
      <text class="guide-title">欢迎使用工作时薪观察器</text>
      <text class="guide-desc">请先登录并设置个人信息，以使用完整功能</text>

      <!-- 登录按钮 -->
      <button class="guide-login-btn" bindtap="handleLogin">
        立即登录
      </button>
    </view>
  </view>

  <!-- 已登录时显示的完整界面 -->
  <view wx:else>
  <!-- 头部 -->
  <view class="profile-header">
    <!-- 未登录状态 -->
    <view class="user-info" wx:if="{{!userInfo.isLogin}}">
      <view class="avatar">👤</view>
      <view class="user-details">
        <text class="username">未登录</text>
        <button class="login-btn" bindtap="handleLogin">点击登录</button>
      </view>
    </view>

    <!-- 已登录状态 -->
    <view class="user-info" wx:if="{{userInfo.isLogin}}">
      <!-- 头像（可点击修改） -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar">👤</view>
      </button>
      <view class="user-details">
        <!-- 昵称（可点击修改） -->
        <text class="username" bindtap="showNicknameInput">{{userInfo.nickName}}</text>
        <text class="work-info">工龄 {{workYears}} · 已记录 {{recordDays}} 天 · ID {{userInfo.shortId}}</text>
      </view>
    </view>

    <!-- 快捷统计 -->
    <view class="quick-stats">
      <view class="stat-card">
        <text class="stat-value">¥{{monthlySalary}}</text>
        <text class="stat-label">当前月薪</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">¥{{totalEarned}}</text>
        <text class="stat-label">累计已赚</text>
      </view>
    </view>
  </view>

  <!-- 状态统计 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stats-header">
        <text class="stats-title">工作状态统计</text>
        <!-- 时间维度切换 -->
        <view class="dimension-tabs">
          <text
            class="tab-item {{dimensionTab === 'day' ? 'active' : ''}}"
            bindtap="switchDimension"
            data-value="day"
          >日</text>
          <text
            class="tab-item {{dimensionTab === 'week' ? 'active' : ''}}"
            bindtap="switchDimension"
            data-value="week"
          >周</text>
          <text
            class="tab-item {{dimensionTab === 'month' ? 'active' : ''}}"
            bindtap="switchDimension"
            data-value="month"
          >月</text>
          <text
            class="tab-item {{dimensionTab === 'year' ? 'active' : ''}}"
            bindtap="switchDimension"
            data-value="year"
          >年</text>
        </view>
      </view>

      <!-- 环形图和图例 -->
      <view class="stats-content">
        <view class="chart-container">
          <view class="donut-chart" style="{{chartStyle}}">
            <view class="donut-center">
              <text class="donut-value">{{totalHours}}h</text>
              <text class="donut-label">总时长</text>
            </view>
          </view>
        </view>

        <view class="legend-list">
          <view class="legend-item">
            <view class="legend-dot" style="background: #0052d9;"></view>
            <view class="legend-info">
              <text class="legend-name">普通模式</text>
              <text class="legend-detail">{{modeStats.normal.hours}}h · {{modeStats.normal.percent}}% · ¥{{modeStats.normal.amount}}</text>
            </view>
          </view>
          <view class="legend-item">
            <view class="legend-dot" style="background: #ed7b2f;"></view>
            <view class="legend-info">
              <text class="legend-name">燃尽模式</text>
              <text class="legend-detail">{{modeStats.burnout.hours}}h · {{modeStats.burnout.percent}}% · ¥{{modeStats.burnout.amount}}</text>
            </view>
          </view>
          <view class="legend-item">
            <view class="legend-dot" style="background: #00a870;"></view>
            <view class="legend-info">
              <text class="legend-name">摸鱼模式</text>
              <text class="legend-detail">{{modeStats.slack.hours}}h · {{modeStats.slack.percent}}% · ¥{{modeStats.slack.amount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 参数设置 -->
  <view class="settings-section">
    <text class="section-title">参数设置</text>
    <t-cell-group theme="card">
      <t-cell
        title="月薪设置"
        note="¥{{monthlySalary}}"
        arrow
        left-icon="💰"
        hover
        bindtap="editSalary"
      />
      <t-cell
        title="工作日设置"
        note="{{workdays}}"
        arrow
        left-icon="📅"
        hover
        bindtap="editWorkdays"
      />
      <t-cell
        title="工作时段"
        note="{{worktime}}"
        arrow
        left-icon="⏰"
        hover
        bindtap="editWorktime"
      />
      <t-cell
        title="工龄设置"
        note="{{workYears}}"
        arrow
        left-icon="👔"
        hover
        bindtap="editWorkTenure"
      />
    </t-cell-group>
  </view>

  <!-- 其他设置 -->
  <view class="settings-section">
    <text class="section-title">其他</text>
    <t-cell-group theme="card">
      <t-cell
        wx:if="{{userInfo.isLogin}}"
        title="退出登录"
        arrow
        left-icon="⎋"
        hover
        bindtap="handleLogout"
      />
      <t-cell
        title="帮助与反馈"
        arrow
        left-icon="❓"
        hover
        bindtap="showHelp"
      />
      <t-cell
        title="关于"
        note="v1.0.0"
        arrow
        left-icon="ℹ️"
        hover
        bindtap="showAbout"
      />
    </t-cell-group>
  </view>
  </view>
</view>
