.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 登录引导界面 */
.login-guide {
  min-height: 100vh;
  background: linear-gradient(165deg, #4a6fa5 0%, #7fa4c3 40%, #a8c5da 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.guide-card {
  background: white;
  border-radius: 32rpx;
  padding: 80rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.guide-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.guide-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.guide-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.guide-login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(165deg, #4a6fa5 0%, #7fa4c3 40%, #a8c5da 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  margin: 0;
}

.guide-login-btn::after {
  border: none;
}


/* 头部 */
.profile-header {
  background: linear-gradient(165deg, #4a6fa5 0%, #7fa4c3 40%, #a8c5da 100%);
  padding: 96rpx 48rpx 64rpx;
  padding-top: env(safe-area-inset-top);
  color: white;
}

/* 自定义导航栏 */
.custom-nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 80rpx;
  margin-bottom: 40rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
  position: relative;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.avatar-img {
  object-fit: cover;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
}

.work-info {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 登录按钮 */
.login-btn {
  padding: 8rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 48rpx;
  color: white;
  font-size: 24rpx;
  line-height: 1.5;
  margin: 0;
  backdrop-filter: blur(10rpx);
}

.login-btn::after {
  border: none;
}

/* 头像按钮 */
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

/* 快捷统计 */
.quick-stats {
  display: flex;
  gap: 32rpx;
}

.stat-card {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* 统计部分 */
.stats-section {
  padding: 0 48rpx;
  margin-top: -32rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.stats-card {
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
}

/* 维度切换 */
.dimension-tabs {
  display: flex;
  gap: 24rpx;
}

.tab-item {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #7fa4c3;
  border-bottom: 4rpx solid #7fa4c3;
  font-weight: 500;
}

/* 统计内容 */
.stats-content {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

/* 环形图 */
.chart-container {
  flex-shrink: 0;
}

.donut-chart {
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.donut-center {
  width: 144rpx;
  height: 144rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.donut-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #242424;
}

.donut-label {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 图例 */
.legend-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.legend-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #242424;
}

.legend-detail {
  font-size: 20rpx;
  color: #999;
}

/* 设置部分 */
.settings-section {
  padding: 32rpx 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin-bottom: 24rpx;
}

/* TDesign Cell 自定义样式 */
.settings-section ::v-deep .t-cell__left-icon {
  font-size: 40rpx;
}
