.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 头部 */
.profile-header {
  background: linear-gradient(135deg, #0052d9 0%, #667eea 100%);
  padding: 96rpx 48rpx 64rpx;
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
}

.work-info {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 快捷统计 */
.quick-stats {
  display: flex;
  gap: 32rpx;
}

.stat-card {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* 统计部分 */
.stats-section {
  padding: 0 48rpx;
  margin-top: -32rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.stats-card {
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
}

/* 维度切换 */
.dimension-tabs {
  display: flex;
  gap: 24rpx;
}

.tab-item {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #0052d9;
  border-bottom: 4rpx solid #0052d9;
  font-weight: 500;
}

/* 统计内容 */
.stats-content {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

/* 环形图 */
.chart-container {
  flex-shrink: 0;
}

.donut-chart {
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.donut-center {
  width: 144rpx;
  height: 144rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.donut-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #242424;
}

.donut-label {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 图例 */
.legend-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.legend-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #242424;
}

.legend-detail {
  font-size: 20rpx;
  color: #999;
}

/* 设置部分 */
.settings-section {
  padding: 32rpx 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #242424;
  margin-bottom: 24rpx;
}

/* TDesign Cell 自定义样式 */
.settings-section ::v-deep .t-cell__left-icon {
  font-size: 40rpx;
}
